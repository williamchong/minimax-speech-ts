{
  "name": "minimax-speech-ts",
  "version": "0.1.1",
  "description": "MiniMax TTS (Text-to-Speech) SDK for Node.js — speech synthesis, streaming, voice cloning & voice design",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "minimax",
    "minimax-api",
    "minimax-tts",
    "minimax-sdk",
    "tts",
    "text-to-speech",
    "speech-synthesis",
    "voice-cloning",
    "voice-generation",
    "t2a",
    "ai",
    "streaming",
    "sse"
  ],
  "author": "William Chong <me@williamchong.cloud>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamchong/minimax-speech-ts.git"
  },
  "homepage": "https://github.com/williamchong/minimax-speech-ts",
  "bugs": {
    "url": "https://github.com/williamchong/minimax-speech-ts/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "eventsource-parser": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.2",
    "eslint": "^9.39.2",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.16",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.0.0"
  }
}
